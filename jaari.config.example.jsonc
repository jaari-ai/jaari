{
  "owner": { "timezone": "America/New_York", "quietHours": ["22:00", "08:00"] },

  // ADR-017: where this daemon runs. "vps" | "server" | "home" | "laptop"
  "deployment": { "target": "vps", "overlay": "tailscale" },

  "persona": { "curiosity": 2, "proactivity": 1 },

  "memory": {
    "repo": "~/.jaari/memory",
    "canonicalizeEveryHours": 6,
    "auditDailyAt": "07:00"
  },

  "llm": {
    "providers": {
      "local":      { "api": "openai-completions", "baseUrl": "http://localhost:11434/v1" },
      "anthropic":  { "apiKey": "secretRef:llm.anthropic" },
      "openrouter": { "apiKey": "secretRef:llm.openrouter" }
    },
    "tiers": {
      "small":  ["local/<small-model>", "openrouter/<cheap-model>"],
      "medium": ["local/<mid-model>", "anthropic/<mid-model>"],
      "large":  ["anthropic/<frontier-model>", "openrouter/<frontier-model>"]
    },
    "roles": {
      "main": "large", "child": "medium", "canonicalize": "medium",
      "curiosity": "small", "classify": "small", "summarize": "small", "title": "small",
      "reader": "small", "vision": { "capability": "image" }
    },
    // ADR-019: `jaari init` sets this only if a local model passes `jaari llm eval`.
    "privacy": { "localOnly": ["canonicalize", "curiosity"] },
    // ADR-046: `jaari init` suggests 30 (api-only), 20 (hybrid), or 0 (local-only).
    // At the limit the owner chooses (raise, cheaper chat model, local only).
    "budget": { "monthlyUsd": 30, "resetDay": 1, "perRoleUsd": { "child": 10 }, "warnAt": [0.5, 0.8], "graceOverrun": 0.1, "onExceeded": "ask", "explainTimes": 3 },
    "escalation": { "allowRequest": ["child"], "maxPerDay": 20 }
  },

  "web": {
    "search": {
      "chain": ["searxng", "brave"],
      "providers": {
        "searxng": { "url": "http://localhost:8888" },
        "brave":   { "apiKey": "secretRef:web.brave" },
        "tavily":  { "apiKey": "secretRef:web.tavily", "enabled": false },
        "exa":     { "apiKey": "secretRef:web.exa", "enabled": false }
      },
      "localOnlyRoles": ["curiosity", "canonicalize"]
    },
    "fetch": {
      // ADR-049: Lightpanda is optional and off by default; add it after http-readability.
      "ladder": ["http-readability", "chromium-local", "jina"],
      "firecrawlCompatible": { "url": "http://localhost:3002", "enabled": false },
      "escalateOn": ["403", "429", "challenge-page", "text<500", "js-required"]
    },
    "browser": {
      "driver": "playwright-mcp",
      // ADR-017: run it where the owner's identity is (home hardware or an owner node).
      "host": "node:home-mini-pc",
      "remote": { "cdpUrl": "secretRef:browser.cdp", "enabled": false },
      "disabledTools": ["browser_run_code_unsafe"]
    },
    // ADR-102: paid search, hosted fetch, hosted browsers, and paid egress; at the limit,
    // self-hosted services only until the reset.
    "budget": { "monthlyUsd": 10, "onExceeded": "self-hosted-only" }
  },

  // ADR-017: owner accounts pin to one owner exit node; rotation is for anonymous traffic.
  "egress": {
    "ownerAccounts": { "provider": "owner-exit", "node": "home-mini-pc", "failoverTo": [] },
    "anonymous": {
      "rotate": ["owner-exit:home-mini-pc", "owner-exit:laptop"],
      "residentialProxy": { "enabled": false }
    }
  }
}
